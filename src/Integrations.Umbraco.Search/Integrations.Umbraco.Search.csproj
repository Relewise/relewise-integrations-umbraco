<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Version>19.0.0-rc1</Version>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Relewise.Integrations.Umbraco.Search</AssemblyName>
    <RootNamespace>Relewise.Integrations.Umbraco.Search</RootNamespace>
    <PackageId>Relewise.Integrations.Umbraco.Search</PackageId>
    <Title>Relewise Search for Umbraco</Title>
    <Description>Umbraco Search indexing and Content/Product query providers for the Relewise Umbraco integration.</Description>
    <Authors>Relewise</Authors>
    <Company>Relewise</Company>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/Relewise/relewise-integrations-umbraco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Relewise/relewise-integrations-umbraco</RepositoryUrl>
    <PackageTags>Relewise;Umbraco;Search;SearchEngine;Indexing</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Integrations.Umbraco/Integrations.Umbraco.csproj" />
    <InternalsVisibleTo Include="Relewise.Integrations.Umbraco.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../Integrations.Umbraco/logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
