<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<AssemblyName>Relewise.Integrations.Umbraco.Tests</AssemblyName>
		<RootNamespace>Relewise.Integrations.Umbraco.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="Moq" Version="4.21.0" />
		<PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
		<PackageReference Include="Umbraco.Cms" Version="19.0.0-rc1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Integrations.Umbraco\Integrations.Umbraco.csproj" />
		<!-- Exercise the maintained example source without exposing its implementation in the package. -->
		<Compile Include="../../samples/Relewise.DemoStorefront/EditorialMapper.cs" Link="Examples/EditorialMapper.cs" />
		<Compile Include="../../samples/Relewise.DemoStorefront/EditorialBlocksConverter.cs" Link="Examples/EditorialBlocksConverter.cs" />
		<Compile Include="../../samples/Relewise.DemoStorefront/EditorialBlockText.cs" Link="Examples/EditorialBlockText.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
