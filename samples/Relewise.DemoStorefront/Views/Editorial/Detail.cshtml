@using Relewise.DemoStorefront.Features.Editorial
@model EditorialPageModel
@await Html.PartialAsync(
    "/Views/Shared/_Breadcrumb.cshtml",
    StorefrontNavigation.Breadcrumb(Model.Page, Context, "journal"))
<article class="reading">
    <header class="article-header">
        <p class="eyebrow">@Text(Context, "Journal")</p>
        <h1>@Title(Model.Page)</h1>
        <p class="lead">@(Model.Page.Value<string>("bodyText"))</p>
    </header>
    @foreach (EditorialSection block in Model.Sections)
    {
        if (!string.IsNullOrWhiteSpace(block.Heading))
        {
            <h2>@block.Heading</h2>
        }
        @* Only Umbraco's rich-text value is trusted HTML; headings and other CMS strings are encoded. *@
        @Html.Raw(block.Text?.ToHtmlString())
    }
    <p class="reading-back">
        <a class="text-link"
            href="@(DemoMarket.Current(Context).StoreUrl)?type=article">@Text(Context, "ReturnJournal")</a>
    </p>
</article>
@await Html.PartialAsync("/Views/Shared/_IntegrationDetails.cshtml", IntegrationDetails.Fields(Model.Page, Context))
