<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Relewise.Integrations.Umbraco.DemoStorefront</AssemblyName>
    <RootNamespace>Relewise.Integrations.Umbraco.DemoStorefront</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="19.0.0-rc1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <ProjectReference Include="../../src/Integrations.Umbraco.Search/Integrations.Umbraco.Search.csproj" />
    <ProjectReference Include="../../src/Integrations.Umbraco/Integrations.Umbraco.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Relewise.Integrations.Umbraco.DemoStorefront.Tests" />
  </ItemGroup>
  <!-- Project references use the same dashboard asset copy as an installed package. -->
  <Import Project="../../src/Integrations.Umbraco/build/Relewise.Integrations.Umbraco.targets"
          Condition="Exists('../../src/Integrations.Umbraco/build/Relewise.Integrations.Umbraco.targets')" />
  <ItemGroup>
    <StorefrontClientInputs Include="Client/**" Exclude="Client/node_modules/**" />
    <Content Remove="Client/**;wwwroot/storefront/**" />
    <None Remove="Client/node_modules/**" />
  </ItemGroup>
  <Target Name="RestoreStorefrontClient" Inputs="Client/package.json;Client/package-lock.json" Outputs="Client/node_modules/.package-lock.json">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/Client" />
  </Target>
  <Target Name="BuildStorefrontClient" BeforeTargets="AssignTargetPaths" DependsOnTargets="RestoreStorefrontClient"
          Inputs="@(StorefrontClientInputs)" Outputs="wwwroot/storefront/listing.js">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/Client" />
  </Target>
  <Target Name="IncludeStorefrontClient" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildStorefrontClient">
    <ItemGroup>
      <Content Include="wwwroot/storefront/**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
